# Copy this file to .env and fill in your real API key.
# Never commit the .env file itself to GitHub.

FORTYGUARD_API_KEY=your_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# Optional tuning (defaults shown)
FORTYGUARD_REQUEST_TIMEOUT=30
FORTYGUARD_MAX_RETRIES=3
FORTYGUARD_RETRY_BACKOFF_BASE=1.5
FORTYGUARD_POLL_INTERVAL=5
FORTYGUARD_POLL_MAX_ATTEMPTS=120
FORTYGUARD_MAX_CONCURRENCY=5